{
  "name": "salah-companion-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Production-ready backend for Salah Companion Prayer Tracker",
  "main": "src/server.js",
  "scripts": {
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node scripts/initSupabaseTables.js",
    "db:migrate:data": "node scripts/migrateSqliteToSupabase.js",
    "db:check": "node scripts/checkDatabase.js",
    "db:studio": "prisma studio",
    "test": "node tests/transliterateUrdu.test.js && node tests/hadithApi.test.js && node tests/googleAuth.test.js && node tests/emailAuth.test.js && node tests/notificationService.test.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "adhan": "^4.4.6",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^11.2.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "prisma": "^6.19.3",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {}
}
