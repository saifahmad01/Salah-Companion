# ============================================================================
# Salah Companion - Backend Environment Configuration Template
# ============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Security / CORS (Comma-separated allowed origins or single frontend URL)
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5000

# Supabase PostgreSQL Database Connection
# Pooler connection (Port 6543) for high concurrency on Render/Serverless:
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (Port 5432) for running migrations:
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
DATABASE_PATH=./database.sqlite
DATABASE_SSL=true
DB_POOL_MAX=10

# Supabase API Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRES_IN=7d

# Prime window (in minutes) for on_time status evaluation (default: 35)
PRIME_WINDOW_MINUTES=35

# Official HadithAPI.com Integration
HADITH_API_BASE_URL=https://hadithapi.com/api/hadiths
HADITH_API_KEY=your_hadith_api_key_here
HADITH_CACHE_TTL=86400
HADITH_CACHE_MAX_SIZE=500

# Nodemailer / Transactional Email Verification
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="Salah Companion <your_email@gmail.com>"
VERIFICATION_TOKEN_TTL_HOURS=24
VERIFICATION_RESEND_COOLDOWN_SEC=60

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Web Push VAPID Credentials (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:your_email@example.com
