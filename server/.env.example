# ============================================================================
# Salah Companion - Backend Environment Configuration Template (.env.example)
#
# Choose your active environment profile:
# - For local development: copy to `server/.env.development` or `server/.env`
# - For Render production: set these variables in the Render Service Dashboard
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Server Network Configuration
# ----------------------------------------------------------------------------
# Local Dev: 8080 | Production (Render): 10000 or automatically assigned
PORT=8080
NODE_ENV=development

# ----------------------------------------------------------------------------
# 2. Dynamic CORS & Host Resolution
# ----------------------------------------------------------------------------
# Development: Allow local Vite (5173), Next/React (3000), API (8080)
# Production: Set strictly to https://salahcompanion786.netlify.app
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:8080
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:8080

# ----------------------------------------------------------------------------
# 3. Supabase PostgreSQL Database Connection
# ----------------------------------------------------------------------------
# Pooler connection (Port 6543, Transaction mode) for zero-connection-spike cost:
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (Port 5432) for running migrations:
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
DATABASE_PATH=./database.sqlite
DATABASE_SSL=true
DB_POOL_MAX=10

# Supabase API Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# ----------------------------------------------------------------------------
# 4. JWT Session Authentication
# ----------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRES_IN=7d

# ----------------------------------------------------------------------------
# 5. Business Logic & Cache Configuration
# ----------------------------------------------------------------------------
PRIME_WINDOW_MINUTES=35
HADITH_API_BASE_URL=https://hadithapi.com/api/hadiths
HADITH_API_KEY=your_hadith_api_key_here
HADITH_CACHE_TTL=86400
HADITH_CACHE_MAX_SIZE=500

# ----------------------------------------------------------------------------
# 6. Email Delivery (SMTP / HTTP REST API)
# ----------------------------------------------------------------------------
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_16_char_app_password
EMAIL_FROM="Salah Companion <your_email@gmail.com>"
VERIFICATION_TOKEN_TTL_HOURS=24
VERIFICATION_RESEND_COOLDOWN_SEC=60

# Optional: Resend API Key to bypass Render free-tier SMTP port blocking over HTTPS (port 443)
# RESEND_API_KEY=re_your_api_key_here

# ----------------------------------------------------------------------------
# 7. Google OAuth 2.0 Credentials
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Dev: http://localhost:8080/api/auth/google/callback
# Prod: https://salah-companion-z3i4.onrender.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback

# ----------------------------------------------------------------------------
# 8. Web Push VAPID Credentials (generate with: npx web-push generate-vapid-keys)
# ----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:your_email@example.com
